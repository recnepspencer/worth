+
+fn carry_member(
+    members: &mut ExecutionOrderedMap<RelationalDurableMemberLocator, RelationalCheckpointMember>,
+    locator: RelationalDurableMemberLocator,
+    request: &ExecutionRequest<'_, '_>,
+) -> Result<(), Denial> {
+    crate::execution::check_request(request).map_err(Denial::Request)?;
+    if members.get(&locator).is_none() {
+        members.insert_cloned_native_for_request(
+            &locator, &RelationalCheckpointMember::Carried { locator }, *request,
+        ).map_err(map_stop)?;
+    }
+    Ok(())
+}
+fn insert_node(
+    nodes: &mut ExecutionOrderedMap<(u64, u64), RelationalCheckpointPage>,
+    page: RelationalCheckpointPage,
+    request: &ExecutionRequest<'_, '_>,
+) -> Result<(), Denial> {
+    let key = (page.range(), page.first);
+    if nodes.contains_key(&key) { return Err(Denial::OriginalAuthorityUnavailable); }
+    nodes.insert_cloned_native_for_request(&key, &page, *request).map_err(map_stop)?;
+    Ok(())
+}
