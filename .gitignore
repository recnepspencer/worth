# OS
.DS_Store
Thumbs.db

# Traces (auto-generated by WORTH_TRACE_DIR)
traces/
# Hand-written TLA+ traces and the chosen DST baselines (dst-*) are model
# fixtures and are versioned; other generated traces next to them stay
# ignored. Git cannot re-include a file under an ignored directory, so the
# TLA+ trace directories are re-included first.
!specs/tla/**/traces/
specs/tla/**/traces/*
!specs/tla/**/traces/hand-*.ndjson
!specs/tla/**/traces/dst-*.ndjson

# Environment
.env
.venv/
__pycache__/
*.pyc

