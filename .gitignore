# Rust build artifacts
# Root target output is also rejected by scripts/ci/check_root_build_artifacts.py.
/target/
**/target/
/target-*/
**/target-*/
!crates/worth-runtime-bridge/src/input/envelope/target/
!crates/worth-runtime-bridge/src/input/envelope/target/native_basis.rs
!workspaces/worth-query/crates/worth-query-execution/src/domain_computation/primary_graph/causal_inspection/application_inspection/target/
!workspaces/worth-query/crates/worth-query-execution/src/domain_computation/primary_graph/causal_inspection/application_inspection/target/**
!workspaces/worth-query/crates/worth-query-execution/src/court_doors_for_test/domain_computation/primary_graph/causal_inspection/application_inspection/target/
!workspaces/worth-query/crates/worth-query-execution/src/court_doors_for_test/domain_computation/primary_graph/causal_inspection/application_inspection/target/**

# AI / agent state
.gemini/
.claude/*
!.claude/settings.json
.codex-tmp/
.codex-artifacts/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Traces (auto-generated by WORTH_TRACE_DIR)
traces/
# Hand-written TLA+ traces are model fixtures and are versioned; generated
# traces next to them stay ignored. Git cannot re-include a file under an
# ignored directory, so the TLA+ trace directories are re-included first.
!specs/tla/**/traces/
specs/tla/**/traces/*
!specs/tla/**/traces/hand-*.ndjson

# Environment
.env
.venv/
__pycache__/
*.pyc

# Build logs & error dumps
*.log
build_errors.txt
cargo_errors.txt
compile_errors.txt

# Scratch / one-off files
mb_n4_log.txt

# Cross-provider runner handoff artifacts (plan/findings passed between provider sessions)
.runner-handoff/

# Repository-owned test control runtime evidence and attempt logs
.store-proof/

# Legacy runner state and local Store certification target directories
/automation/phase_runner/
/workspaces/worth-store/p8f/
/workspaces/worth-store/p8m/

# Claude Code personal overrides
.claude/settings.local.json

# Lean 4 Lake build cache
**/.lake/
