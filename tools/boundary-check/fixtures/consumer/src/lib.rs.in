mod values;

trait ValueBinding {
    type Value;
    const DOMAIN_VALUE: bool;
}

struct MeasurementBinding;
impl ValueBinding for MeasurementBinding {
    type Value = values::Measurement;
    const DOMAIN_VALUE: bool = true;
}

