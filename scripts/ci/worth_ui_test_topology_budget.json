{
  "workspace_manifest": "workspaces/worth-ui/Cargo.toml",
  "lane_runner": "scripts/ci/run_worth_ui_test_lane.py",
  "proof_lanes": {
    "fast": [
      "worth-ui:capability_contracts",
      "worth-ui:registry_contracts"
    ],
    "compile-contracts": [
      "worth-ui-certification:compile_contracts"
    ],
    "hostile-certification": [
      "worth-ui-certification:application_contracts",
      "worth-ui-certification:declaration_contracts",
      "worth-ui-certification:graph_contracts",
      "worth-ui-certification:inspection_contracts",
      "worth-ui-certification:measurement_contracts",
      "worth-ui-certification:obligation_contracts",
      "worth-ui-certification:topology_contracts"
    ],
    "dependency-contract": [
      "worth-ui-certification:host_contract_only_adapter"
    ],
    "native-platform": [
      "worth-ui-platform-pulse:executable_world"
    ]
  },
  "external_proof_targets": [
    "worth-ui-certification:host_contract_only_adapter",
    "worth-ui-certification:compile_contracts"
  ],
  "packages": {
    "worth-ui": {
      "manifest": "workspaces/worth-ui/crates/worth-ui/Cargo.toml",
      "max_integration_targets": 6,
      "expected_integration_targets": [
        "capability_contracts",
        "registry_contracts"
      ]
    },
    "worth-ui-certification": {
      "manifest": "workspaces/worth-ui/crates/worth-ui-certification/Cargo.toml",
      "max_integration_targets": 9,
      "expected_integration_targets": [
        "application_contracts",
        "declaration_contracts",
        "graph_contracts",
        "inspection_contracts",
        "measurement_contracts",
        "obligation_contracts",
        "topology_contracts"
      ]
    },
    "worth-ui-host-contract": {
      "manifest": "workspaces/worth-ui/crates/worth-ui-host-contract/Cargo.toml",
      "max_integration_targets": 0,
      "expected_integration_targets": []
    },
    "worth-ui-platform-pulse": {
      "manifest": "workspaces/worth-ui/apps/platform-pulse/Cargo.toml",
      "max_integration_targets": 1,
      "expected_integration_targets": [
        "executable_world"
      ]
    }
  },
  "max_compile_contract_targets": 0,
  "max_trybuild_sessions": 0,
  "compile_contract_fixture_manifest": "workspaces/worth-ui/crates/worth-ui-certification/tests/fixtures/compile_contracts/Cargo.toml",
  "compile_contract_runner": "scripts/ci/run_worth_ui_compile_contracts.py",
  "max_compile_cargo_sessions": 2,
  "compile_contract_sessions": {
    "worth-ui": {
      "inventory": "workspaces/worth-ui/crates/worth-ui/tests/suites/compile_contract_cases.csv",
      "execution": "workspaces/worth-ui/crates/worth-ui/tests/suites/compile_contract_execution.csv",
      "aggregation_groups": [
        {
          "name": "facade_construction",
          "patterns": [
            "^tests/ui/(facade|facade_visibility)/"
          ]
        },
        {
          "name": "runtime_authority",
          "patterns": [
            "^tests/ui/runtime_authority/"
          ]
        },
        {
          "name": "runtime_lifecycle",
          "patterns": [
            "^tests/ui/runtime_(source_ingress|file_rust_replacement_parity|plan_swap|reload_failure|reload_storm_certification|state_query_authority)/"
          ]
        },
        {
          "name": "runtime_execution",
          "patterns": [
            "^tests/ui/runtime_(canvas_spatial_lane|identity_state_query_certification|lane_admission|lane_frame_cost_certification|measurement|ordinary_lane|realtime_overlay_lane|reload_counter_boundary|steady_frame_counter_boundary|virtualized_data_lane)/"
          ]
        },
        {
          "name": "runtime_diagnostics",
          "patterns": [
            "^tests/ui/runtime_(diagnostics|outcome_projection|plan_inspection)/"
          ]
        }
      ],
      "structural_replacement_patterns": [
        "fields_not_public",
        "not_publicly_mintable",
        "internal_module_not_public",
        "type_not_publicly_importable",
        "constructor_not_public",
        "not_public_facade_api",
        "not_publicly_constructible",
        "constructors_not_public",
        "storage_not_public",
        "snapshot_builder_not_public",
        "snapshot_freeze_input_not_public",
        "snapshot_index_parts_not_public",
        "unattributed_work_bucket_not_public",
        "internal_.*import_fails",
        "root_does_not",
        "does_not_export",
        "constructor_fails"
      ]
    },
    "worth-ui-certification": {
      "inventory": "workspaces/worth-ui/crates/worth-ui-certification/tests/suites/compile_contract_cases.csv",
      "execution": "workspaces/worth-ui/crates/worth-ui-certification/tests/suites/compile_contract_execution.csv",
      "aggregation_groups": [
        {
          "name": "declaration_and_admission",
          "patterns": [
            "^tests/ui/(admission|declaration)"
          ]
        },
        {
          "name": "graph_and_obligation",
          "patterns": [
            "^tests/ui/(graph|obligation)"
          ]
        },
        {
          "name": "measurement_authority",
          "patterns": [
            "^tests/ui/(measurement|host)"
          ]
        },
        {
          "name": "inspection_and_lifecycle",
          "patterns": [
            "^tests/ui/(inspection|facade_export|evidence_construction|lifecycle)/"
          ]
        }
      ],
      "structural_replacement_patterns": [
        "runtime_facade_root_does_not_export",
        "product_compat_module_does_not_export",
        "facade_does_not_export",
        "cannot_import",
        "crate_root_does_not_bypass",
        "_is_not_public",
        "_are_private",
        "fields_are_private",
        "constructor_is_private",
        "via_struct_literal",
        "via_variant_literal"
      ]
    },
    "worth-ui-host-contract": {
      "inventory": "workspaces/worth-ui/crates/worth-ui-host-contract/tests/suites/compile_contract_cases.csv",
      "execution": "workspaces/worth-ui/crates/worth-ui-host-contract/tests/suites/compile_contract_cases.csv",
      "structural_replacement_patterns": []
    }
  },
  "filesystem_provider_source": "workspaces/worth-ui/crates/worth-ui-runtime/src/runtime/source_ingress/filesystem/filesystem_source_provider.rs",
  "real_filesystem_proof_sources": [
    "workspaces/worth-ui/crates/worth-ui-certification/src/scenario/filesystem_application_lifecycle.rs",
    "workspaces/worth-ui/crates/worth-ui-certification/tests/application_contracts/filesystem_source_acquisition.rs",
    "workspaces/worth-ui/crates/worth-ui-certification/tests/application_contracts/filesystem_watcher_settlement.rs",
    "workspaces/worth-ui/crates/worth-ui-certification/tests/application_contracts/multi_removal_filesystem.rs"
  ],
  "workspace_source_inventory_owner": "workspaces/worth-ui/crates/worth-ui-certification/src/topology/workspace_source_inventory.rs",
  "workspace_source_inventory_suite": "workspaces/worth-ui/crates/worth-ui-certification/tests/suites/topology_contracts.rs",
  "required_source_paths": [
    "workspaces/worth-ui/crates/worth-ui-inspection/src/target/mod.rs",
    "workspaces/worth-ui/crates/worth-ui-inspection/src/target/inspection_target.rs",
    "workspaces/worth-ui/crates/worth-ui-inspection/src/target/source_artifact_identity.rs",
    "workspaces/worth-ui/crates/worth-ui-certification/tests/fixtures/topology_negative/inspection_role_purity_drift/crates/worth-ui-inspection/src/target/mod.rs"
  ],
  "allowed_trybuild_sessions": []
}
