appearance role platform.pulse.appearance.review_target applies_to platform.pulse.component.review_target {
  background use token(theme.platform_pulse.elevated_surface)
}
component platform.pulse.component.review_target {
  appearance { role platform.pulse.appearance.review_target }
  interaction activate routes platform.pulse.portal.open.route opens portal platform.pulse.portal.review;
}

appearance role platform.pulse.appearance.review_label applies_to platform.pulse.component.review_label {
  foreground use token(theme.platform_pulse.secondary_text)
}
component platform.pulse.component.review_label {
  appearance { role platform.pulse.appearance.review_label }

}

component platform.pulse.component.review_surface {
}

appearance role platform.pulse.appearance.review_title applies_to platform.pulse.component.review_title {
  foreground use token(theme.platform_pulse.primary_text)
}
component platform.pulse.component.review_title {
  appearance { role platform.pulse.appearance.review_title }

}

appearance role platform.pulse.appearance.review_body applies_to platform.pulse.component.review_body {
  foreground use token(theme.platform_pulse.secondary_text)
}
component platform.pulse.component.review_body {
  appearance { role platform.pulse.appearance.review_body }

}

appearance role platform.pulse.appearance.review_cancel_target applies_to platform.pulse.component.review_cancel_target {
  background use token(theme.platform_pulse.raised_surface)
}
component platform.pulse.component.review_cancel_target {
  appearance { role platform.pulse.appearance.review_cancel_target }
  interaction activate routes platform.pulse.portal.cancel.route;
}

appearance role platform.pulse.appearance.review_cancel_label applies_to platform.pulse.component.review_cancel_label {
  foreground use token(theme.platform_pulse.secondary_text)
}
component platform.pulse.component.review_cancel_label {
  appearance { role platform.pulse.appearance.review_cancel_label }

}

appearance role platform.pulse.appearance.review_primary_target applies_to platform.pulse.component.review_primary_target {
  background use token(theme.platform_pulse.action_fill)
}
component platform.pulse.component.review_primary_target {
  appearance { role platform.pulse.appearance.review_primary_target }
  interaction activate routes platform.pulse.action.route;
}

appearance role platform.pulse.appearance.review_primary_label applies_to platform.pulse.component.review_primary_label {
  foreground use token(theme.platform_pulse.action_text)
}
component platform.pulse.component.review_primary_label {
  appearance { role platform.pulse.appearance.review_primary_label }

}

appearance role platform.pulse.appearance.modal_backdrop applies_to backdrop {
  background use token(theme.platform_pulse.modal_scrim)
  opacity use token(theme.platform_pulse.modal_opacity)
}
portal platform.pulse.portal.review {
  surface platform.pulse.surface.main
  anchor platform.pulse.component.review_target
  layer modal
  dismiss escape anchor_gone
  focus first_enabled
  motion system_popover
}
backdrop platform.pulse.backdrop.details {
  scope per_portal_instance platform.pulse.portal.details
  extent surface_viewport platform.pulse.surface.main
  presence while portal platform.pulse.portal.details presented
  motion follow portal platform.pulse.portal.details presentation
  place immediately_before portal platform.pulse.portal.details
  appearance { role platform.pulse.appearance.modal_backdrop }
}
backdrop platform.pulse.backdrop.review {
  scope per_portal_instance platform.pulse.portal.review
  extent surface_viewport platform.pulse.surface.main
  presence while portal platform.pulse.portal.review presented
  motion follow portal platform.pulse.portal.review presentation
  place immediately_before portal platform.pulse.portal.review
  appearance { role platform.pulse.appearance.modal_backdrop }
}
