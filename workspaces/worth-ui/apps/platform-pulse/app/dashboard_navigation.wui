appearance role platform.pulse.appearance.portal_target applies_to platform.pulse.component.portal_target {
  background over [hover] {
    cell outside when hover = outside use token(theme.platform_pulse.search_fill)
    cell hovered when hover = hovered use token(theme.platform_pulse.hover_surface)
  }
  radius use token(theme.platform_pulse.radius.r32)
}
component platform.pulse.component.portal_target {
  appearance { role platform.pulse.appearance.portal_target }
  interaction activate routes platform.pulse.portal.open.route opens portal platform.pulse.portal.details;
}
