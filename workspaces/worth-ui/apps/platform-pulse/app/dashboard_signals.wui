}
appearance role platform.pulse.appearance.portal_primary_target applies_to platform.pulse.component.portal_primary_target {
  background over [hover] {
    cell outside when hover = outside use token(theme.platform_pulse.raised_surface)
    cell hovered when hover = hovered use token(theme.platform_pulse.hover_surface)
  }
  radius use token(theme.platform_pulse.radius.r8)
}
component platform.pulse.component.portal_primary_target {
  appearance { role platform.pulse.appearance.portal_primary_target }
  interaction activate routes platform.pulse.action.route;
}
