appearance role platform.pulse.appearance.signals_shadow applies_to platform.pulse.component.signals_shadow {
  background use token(theme.platform_pulse.shadow)
}
component platform.pulse.component.signals_shadow {
  appearance { role platform.pulse.appearance.signals_shadow }
}
appearance role platform.pulse.appearance.portal_surface applies_to platform.pulse.component.portal_surface {
  background use token(theme.platform_pulse.raised_surface)
  radius use token(theme.platform_pulse.radius.r12)
  border use token(theme.platform_pulse.border.card)
}
component platform.pulse.component.portal_surface {
  appearance { role platform.pulse.appearance.portal_surface }
}
appearance role platform.pulse.appearance.portal_title applies_to platform.pulse.component.portal_title {
  foreground use token(theme.platform_pulse.primary_text)
}
appearance role platform.pulse.appearance.signals_pointer applies_to platform.pulse.component.signals_pointer {
  background use token(theme.platform_pulse.raised_surface)
}
component platform.pulse.component.signals_pointer {
