appearance role platform.pulse.appearance.root applies_to platform.pulse.component.seed {
  background use token(theme.platform_pulse.palette.canvas)
}
appearance role platform.pulse.appearance.brand applies_to platform.pulse.component.brand {
  foreground use token(theme.platform_pulse.principal_accent)
}
appearance role platform.pulse.appearance.query_card applies_to platform.pulse.component.query_card {
  background use token(theme.platform_pulse.raised_surface)
  border use token(theme.platform_pulse.border.query_card)
  radius use token(theme.platform_pulse.radius.query_card)
}
component platform.pulse.component.seed {
  appearance { role platform.pulse.appearance.root }
  region platform.pulse.mosaic.region.viewport {
    sizing platform.pulse.mosaic.sizing.viewport;
    region platform.pulse.mosaic.region.masthead {
      sizing platform.pulse.mosaic.sizing.masthead;
    }
    region platform.pulse.mosaic.region.evidence_rail {
      sizing platform.pulse.mosaic.sizing.evidence_rail;
      mount platform.pulse.surface.evidence placement platform.pulse.mosaic.placement.evidence;
    }
    region platform.pulse.mosaic.region.service_stage {
      sizing platform.pulse.mosaic.sizing.service_stage;
      state platform.pulse.mosaic.state.focused_service_region;
      mount platform.pulse.surface.service placement platform.pulse.mosaic.placement.service;
    }
    region platform.pulse.mosaic.region.status_band {
      sizing platform.pulse.mosaic.sizing.status_band;
      mount platform.pulse.surface.status placement platform.pulse.mosaic.placement.status;
    }
  }
}
component platform.pulse.component.masthead_border {}
component platform.pulse.component.brand {
  appearance { role platform.pulse.appearance.brand }
}
component platform.pulse.component.runtime_badge {}
component platform.pulse.component.evidence_border {}
component platform.pulse.component.evidence_rail {}
component platform.pulse.component.evidence_title {}
component platform.pulse.component.evidence_body {}
component platform.pulse.component.source_signal_title {}
component platform.pulse.component.source_signal_active {}
component platform.pulse.component.evidence_service_label {}
component platform.pulse.component.evidence_service_body {}
component platform.pulse.component.service_stage {}
component platform.pulse.component.service_stage_border {}
component platform.pulse.component.query_accent {}
component platform.pulse.component.lower_shelf_divider {}
component platform.pulse.component.service_eyebrow {}
component platform.pulse.component.service_title {}
component platform.pulse.component.service_body {}
component platform.pulse.component.query_card {
  appearance { role platform.pulse.appearance.query_card }
}
component platform.pulse.component.query_card_border {}
component platform.pulse.component.query_label {}
component platform.pulse.component.native_card {}
component platform.pulse.component.native_card_border {}
component platform.pulse.component.native_label {}
component platform.pulse.component.native_body {}
component platform.pulse.component.query_denial_label {}
component platform.pulse.component.query_denial_body {}
component platform.pulse.component.status_band {}
component platform.pulse.component.status_text {}
component platform.pulse.component.identity_target {
  interaction activate routes platform.pulse.action.route;
}
component platform.pulse.component.action_label {}
component platform.pulse.component.portal_target {
  interaction activate routes platform.pulse.portal.open.route;
  interaction submit routes platform.pulse.portal.close.route;
}
component platform.pulse.component.portal_label {}
component platform.pulse.component.portal_surface {}
component platform.pulse.component.portal_accent {}
component platform.pulse.component.portal_icon_tile {}
component platform.pulse.component.portal_icon_text {}
component platform.pulse.component.portal_title {}
component platform.pulse.component.portal_body {}
component platform.pulse.component.portal_cancel_label {}
component platform.pulse.component.portal_primary_label {}
component platform.pulse.component.confirmation_target {
  interaction activate confirms platform.pulse.action.route;
}
component platform.pulse.component.projected_status {
  content projection platform.pulse.status
}
surface platform.pulse.surface.main {}
surface platform.pulse.surface.evidence {}
surface platform.pulse.surface.service {}
surface platform.pulse.surface.status {}
query_scalar platform.pulse.status {
  view platform.pulse.status
  field status
  require text
  lifecycle live
}
intent platform.pulse.action.route {
  definition platform.pulse.action;
  interaction activate;
  payload action_input_revision application-unsigned64 platform.pulse.action.input-revision;
  payload query_denial_requested application-boolean platform.pulse.action.query-denial-requested;
  operability platform.pulse.action.operability
    mutability-application-boolean platform.pulse.action.mutable
    readiness-application-boolean platform.pulse.action.ready
    policy-application-boolean platform.pulse.action.policy-allowed;
  confirmation platform.pulse.action.confirmation
    application-boolean platform.pulse.action.confirmation-required;
  concurrency target-route-single-flight;
  consequences mounted-posture-and-query platform.pulse.status;
}
intent platform.pulse.portal.open.route {
  definition platform.pulse.portal.open;
  interaction activate;
  operability platform.pulse.portal.open.operability
    mutability-application-boolean platform.pulse.action.mutable
    readiness-application-boolean platform.pulse.action.ready
    policy-application-boolean platform.pulse.action.policy-allowed;
  confirmation platform.pulse.portal.open.confirmation
    application-boolean platform.pulse.action.confirmation-required;
  concurrency target-route-single-flight;
  consequences mounted-posture;
}
intent platform.pulse.portal.close.route {
  definition platform.pulse.portal.close;
  interaction submit;
  operability platform.pulse.portal.close.operability
    mutability-application-boolean platform.pulse.portal.dismiss.mutable
    readiness-application-boolean platform.pulse.portal.dismiss.ready
    policy-application-boolean platform.pulse.portal.dismiss.policy-allowed;
  confirmation platform.pulse.portal.close.confirmation
    application-boolean platform.pulse.portal.dismiss.confirmation-required;
  concurrency target-route-single-flight;
  consequences mounted-posture;
}
intent platform.pulse.portal.cancel.route {
  definition platform.pulse.portal.close;
  interaction activate;
  operability platform.pulse.portal.cancel.operability
    mutability-application-boolean platform.pulse.portal.dismiss.mutable
    readiness-application-boolean platform.pulse.portal.dismiss.ready
    policy-application-boolean platform.pulse.portal.dismiss.policy-allowed;
  confirmation platform.pulse.portal.cancel.confirmation
    application-boolean platform.pulse.portal.dismiss.confirmation-required;
  concurrency target-route-single-flight;
  consequences mounted-posture;
}
command platform.pulse.command.run.application {
  shortcut Primary+Shift+P;
  scope application;
}
command platform.pulse.command.run.portal {
  shortcut Primary+Shift+P;
  scope active_portal;
  binding platform.pulse.component.portal_target;
}
token theme.platform_pulse.fill = "theme.platform_pulse.blue";
token theme.platform_pulse.canvas = "theme.platform_pulse.palette.canvas";
token theme.platform_pulse.raised_surface = "theme.platform_pulse.palette.raised_surface";
token theme.platform_pulse.elevated_surface = "theme.platform_pulse.palette.elevated_surface";
token theme.platform_pulse.structural_rule = "theme.platform_pulse.palette.structural_rule";
token theme.platform_pulse.primary_text = "theme.platform_pulse.palette.primary_text";
token theme.platform_pulse.secondary_text = "theme.platform_pulse.palette.secondary_text";
token theme.platform_pulse.principal_accent = "theme.platform_pulse.palette.principal_accent";
token theme.platform_pulse.action_text = "theme.platform_pulse.palette.action_text";
token theme.platform_pulse.positive = "theme.platform_pulse.palette.positive";
token theme.platform_pulse.caution = "theme.platform_pulse.palette.caution";
token theme.platform_pulse.identity_target_fill = "theme.platform_pulse.yellow";
token theme.platform_pulse.confirmation_fill = "theme.platform_pulse.purple";
